---
// Optional passkey account panel for the playground pages; rendered by initAccount() in scripts/account.ts.
---
<div class="panel" id="account-panel">
  <div style="display:flex;gap:.7rem;align-items:center;flex-wrap:wrap">
    <h2 style="margin:0;flex:1">Your account <small class="muted" style="font-size:.6em;font-weight:400">optional</small></h2>
    <span id="acct-badge"></span>
  </div>
  <div id="acct-body" class="out"><p class="muted">Loading…</p></div>
  <div id="acct-msg" class="out"></div>
</div>
