---
// Client credentials for the sample Transmitter's OAuth sandbox. Shared by the Transmitter and
// Receiver playground pages (same browser storage), wired up by initCreds() in scripts/session.ts.
interface Props { heading: string }
const { heading } = Astro.props;
---
<div class="panel">
  <h2>{heading}</h2>
  <p class="muted" style="margin:0;font-size:.9rem">There is no sign-up. Any <code>client_id</code> works with any <code>client_secret</code> of 16+ characters;
  the pair names your private sandbox, so its streams are invisible to everyone else. The <code>client_id</code> becomes your streams’ <code>aud</code>.
  Kept in this browser and shared between the Transmitter and Receiver pages; use <strong>Copy sandbox link</strong> to open it somewhere else.</p>
  <div class="row">
    <label class="field"><span><code>client_id</code></span><input type="text" id="client_id" spellcheck="false" /></label>
    <label class="field"><span><code>client_secret</code></span><span class="copy"><input type="text" id="client_secret" spellcheck="false" /><button class="btn small" data-copy="client_secret">Copy</button></span></label>
  </div>
  <div class="actions" style="margin:.5rem 0 0">
    <button class="btn primary" id="token-btn">Get access token</button>
    <button class="btn" id="link-btn">Copy sandbox link</button>
    <button class="btn" id="new-creds">New sandbox</button>
    <button class="btn" id="delete-sandbox">Delete sandbox</button>
  </div>
  <div class="out" id="token-out"></div>
  <div class="out" id="link-out"></div>
</div>
