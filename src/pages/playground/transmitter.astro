---
import Base from '../../layouts/Base.astro';
import Credentials from '../../components/Credentials.astro';
import Account from '../../components/Account.astro';
import { EVENTS, uri } from '../../data/events';

// Event picker data: every CAEP, RISC and SCIM type, with the catalogue's example claims as a starting point.
const events = EVENTS.filter((e) => e.spec !== 'ssf').map((e) => {
  const ex = e.example as any;
  const body = ex?.events ? { ...(Object.values(ex.events)[0] as object) } : {};
  delete (body as any).event_timestamp;
  // The CAEP Interoperability Profile (§2.5) allows only email and iss_sub subjects (opaque is for
  // Verification only), so examples using anything else start from an email subject instead. SCIM events
  // keep their "scim" subject, which RFC 9967 requires.
  const sub_id = e.spec === 'scim' || ['email', 'iss_sub'].includes(ex?.sub_id?.format) ? ex.sub_id : { format: 'email', email: 'alice@example.com' };
  return { uri: uri(e), name: e.name, spec: e.spec, deprecated: !!e.deprecated, sub_id, body };
});
---
<Base title="Sample Transmitter" description="A live SSF Transmitter built to the CAEP Interoperability Profile. Fire any CAEP, RISC or SCIM event at your streams and watch it go out.">
  <p class="eyebrow"><a href="/playground/">Playground</a> · Transmitter</p>
  <h1>Sample Transmitter</h1>
  <p class="lede">A live SSF Transmitter at <code>https://shared-signals.dev</code>, built to the
  <a href="/specs/caep-interop/">CAEP Interoperability Profile</a>. This page plays the Transmitter’s side: fire any CAEP, RISC or SCIM event
  at your streams, change a stream’s status as the Transmitter, and see each delivery.</p>

  <div class="callout prose">
    <p><strong>Streams are created by Receivers.</strong> Set one up on the <a href="/playground/receiver/">Receiver page</a>, or have your own
    Receiver do it through the public API: discover <a href="/.well-known/ssf-configuration"><code>/.well-known/ssf-configuration</code></a>,
    get a token from <code>/ssf/oauth/token</code> and <code>POST /ssf/stream</code>. See <a href="#curl">the curl walkthrough</a>.</p>
  </div>

  <Account />

  <div id="playground-body" hidden>
  <Credentials heading="1. Credentials" />

  <div class="panel">
    <div style="display:flex;gap:.7rem;align-items:center;flex-wrap:wrap">
      <h2 style="margin:0;flex:1">2. Your streams</h2>
      <button class="btn small" id="list-btn">Refresh</button>
    </div>
    <p class="muted" style="margin:.4rem 0 0;font-size:.85rem">Status changes here are made by the Transmitter, so it announces them with a
    <a href="/events/#ssf-stream-updated">Stream Updated</a> event (SSF §8.1.5): before pausing or disabling, after re-enabling.</p>
    <div class="out" id="streams"></div>
  </div>

  <div class="panel">
    <h2>3. Fire an event</h2>
    <div class="row">
      <label class="field"><span>Stream</span><select id="fire-stream"><option value="">All my streams</option></select></label>
      <label class="field"><span>Event type</span><select id="fire-type">
        {events.map((e) => <option value={e.uri}>{e.spec.toUpperCase()} · {e.name}{e.deprecated ? ' (deprecated)' : ''}</option>)}
      </select></label>
    </div>
    <div class="row">
      <label class="field"><span><code>sub_id</code></span><textarea id="fire-sub" rows="6" spellcheck="false"></textarea></label>
      <label class="field"><span>Event claims</span><textarea id="fire-body" rows="6" spellcheck="false"></textarea>
        <small>CAEP events get <code>event_timestamp</code> = now and, if you leave it out, a <code>reason_admin</code>. SCIM events (<a href="/events/#scim">RFC 9967</a>) need a <code>scim</code> subject with the resource’s <code>uri</code>.</small></label>
    </div>
    <button class="btn primary" id="fire-btn">Send</button>
    <div class="out" id="fire-out"></div>
  </div>

  <div class="panel" id="log-panel">
    <div style="display:flex;gap:.7rem;align-items:center;flex-wrap:wrap">
      <h2 style="margin:0;flex:1">4. Event log</h2>
      <select id="log-stream" style="width:auto;max-width:16rem"><option value="">All my streams</option></select>
      <span class="radios"><label><input type="checkbox" id="log-auto" checked /> refresh every 5s</label></span>
      <button class="btn small" id="log-btn">Refresh</button>
    </div>
    <p class="muted" style="margin:.4rem 0 0;font-size:.85rem">What the Transmitter did, newest first. Click a row for the detail and the SET it sent.</p>
    <div id="log-status" class="out"></div>
    <div class="feed" id="log" style="margin-top:1rem"></div>
  </div>

  <div class="prose">
    <h2 id="curl">Connect your own Receiver</h2>
    <p>Use any <code>client_id</code> and a secret of 16+ characters. Tokens last an hour and carry
    <code>ssf.read</code> (read config and status, poll) and/or <code>ssf.manage</code> (everything else).</p>
    <pre><code id="curl-text"></code></pre>
    <h3>Limits</h3>
    <ul>
      <li>10 streams per client; 50 undelivered SETs per stream; 30 fired events a minute; 120 API calls a minute per IP.</li>
      <li><code>min_verification_interval</code> is 15 seconds. Streams are deleted after 7 days without Receiver activity (<code>inactivity_timeout</code>).</li>
      <li>Push endpoints must be public <code>https</code> URLs on the default port, by DNS name. Redirects are not followed; failed pushes are retried 4 times over about an hour.</li>
      <li><code>default_subjects</code> is <code>ALL</code>: every subject is in every stream until you call <code>subjects:remove</code>.</li>
      <li>This is a test service. Don’t send real personal data, and don’t rely on it staying up.</li>
    </ul>
  </div>

  </div>

  <script type="application/json" id="events-data" set:html={JSON.stringify(events)} />
</Base>


<script>
  import { api, badge, copyButtons, errorText, esc, eventRow, fillChecks, renderRows, shortType, type EventRow } from '../../scripts/playground';
  import { initAccount, render as renderAccount } from '../../scripts/account';
  import { currentCreds, deliveryCell, initCreds, loadStreams, readHash, statusBadge, streamCell, token, type Stream } from '../../scripts/session';

  type Ev = { uri: string; name: string; sub_id: unknown; body: Record<string, unknown> };
  const EVENTS: Ev[] = JSON.parse(document.getElementById('events-data')!.textContent!);
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const ORIGIN = location.origin;
  let streams: Stream[] = [];
  const nameOf = (sid: string) => esc(streams.find((s) => s.stream_id === sid)?.description || sid);

  // ── Streams (read-only here, plus Transmitter-initiated status) ────────
  async function listStreams() {
    renderCurl();
    const el = $('streams');
    const res = await loadStreams();
    if (typeof res === 'string') { el.innerHTML = `<p class="muted">${esc(res)}</p>`; return; }
    streams = res;
    const sel = $<HTMLSelectElement>('fire-stream');
    const keep = sel.value;
    sel.innerHTML = '<option value="">All my streams</option>' + streams.map((s) => `<option value="${esc(s.stream_id)}">${esc(s.description || s.stream_id)}</option>`).join('');
    sel.value = streams.some((s) => s.stream_id === keep) ? keep : '';
    const ls = $<HTMLSelectElement>('log-stream'), keepLog = ls.value;
    ls.innerHTML = '<option value="">All my streams</option>' + streams.map((s) => `<option value="${esc(s.stream_id)}">${esc(s.description || s.stream_id)}</option>`).join('');
    ls.value = streams.some((s) => s.stream_id === keepLog) ? keepLog : '';
    loadLog();
    if (!streams.length) { el.innerHTML = '<p class="muted">No streams yet. <a href="/playground/receiver/">Create one on the Receiver page</a>.</p>'; return; }
    el.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Stream</th><th>Delivery</th><th>Status</th><th>Actions</th></tr></thead><tbody>${streams.map((s) => `<tr>
        <td>${streamCell(s)}</td><td>${deliveryCell(s)}</td><td>${statusBadge(s.status)}</td>
        <td><div style="display:flex;flex-wrap:wrap;gap:.3rem">
          ${['enabled', 'paused', 'disabled'].filter((x) => x !== s.status).map((x) => `<button class="btn small" data-act="status" data-status="${x}" data-id="${esc(s.stream_id)}">${x === 'enabled' ? 'Enable' : x === 'paused' ? 'Pause' : 'Disable'}</button>`).join('')}
          <button class="btn small" data-act="log" data-id="${esc(s.stream_id)}">Log</button>
        </div></td></tr>`).join('')}</tbody></table></div><div class="out" id="act-out"></div>`;
    el.querySelectorAll<HTMLButtonElement>('button[data-act]').forEach((b) => (b.onclick = () => act(b.dataset.act!, b.dataset.id!, b.dataset.status)));
  }

  async function act(what: string, sid: string, status?: string) {
    if (what === 'log') { $<HTMLSelectElement>('log-stream').value = sid; await loadLog(); $('log-panel').scrollIntoView({ behavior: 'smooth' }); return; }
    const t = await token(); if (!t) return;
    const r = await api('POST', '/api/streams/status', { token: t, body: { stream_id: sid, status, reason: 'Changed by the Transmitter from the playground' } });
    await listStreams(); // re-renders the table, so report afterwards
    const o = document.getElementById('act-out');
    if (o) o.innerHTML = r.status === 200
      ? `<p><strong>${nameOf(sid)}</strong> is now <code>${esc(r.json.status)}</code>. Stream Updated event: <strong>${esc(r.json.stream_updated?.outcome)}</strong> — ${esc(r.json.stream_updated?.detail)}</p>`
      : `<p class="error">${esc(errorText(r))}</p>`;
    loadLog();
  }

  // ── Event log: every stream's log merged, in the same row format as the Receiver feed ──
  const LABEL: Record<string, [EventRow['level'], string]> = {
    pushed: ['pass', 'sent'], queued: ['warn', 'queued'], held: ['warn', 'held'], acknowledged: ['pass', 'acked'],
    'push failed, will retry': ['warn', 'retrying'], 'push failed': ['fail', 'failed'], 'rejected by Receiver': ['fail', 'rejected'],
    dropped: ['fail', 'dropped'], suppressed: ['warn', 'skipped'],
  };
  function toRow(l: any, s: Stream): { key: string; html: string; set?: string } {
    const [level, label] = LABEL[l.action] ?? [l.ok ? 'info' : 'fail', l.ok ? 'info' : 'error'];
    const via = esc(s.description || s.stream_id);
    const row: EventRow = l.event
      ? {
          at: l.at, level, label, eventType: l.event, via, outcome: l.action, detail: l.detail, set: l.set, lazyChecks: !!l.set,
          ...(l.response ? { response: l.response.body ?? null, responseLabel: `Receiver’s response · HTTP ${l.response.status}` } : {}),
        }
      : { at: l.at, level, label, title: l.action, via, outcome: '', detail: l.detail };
    return { key: `${s.stream_id}:${l.at}:${l.action}:${l.jti ?? ''}`, html: eventRow(row), set: l.set };
  }

  async function loadLog() {
    const t = await token(); if (!t) return;
    const sel = $<HTMLSelectElement>('log-stream');
    const which = streams.filter((s) => !sel.value || s.stream_id === sel.value);
    const results = await Promise.all(which.map((s) => api('GET', `/api/streams/log?stream_id=${s.stream_id}`, { token: t }).then((r) => ({ s, r }))));
    const rows: { at: number; key: string; html: string }[] = [];
    const waiting: string[] = [];
    for (const { s, r } of results) {
      if (r.status !== 200) continue;
      for (const l of r.json.log) rows.push({ at: l.at, ...toRow(l, s) });
      for (const q of r.json.queued) waiting.push(`<code>${esc(shortType(q.type))}</code> on ${esc(s.description || s.stream_id)}${q.held ? ' (held)' : q.next_attempt ? ` (retry at ${esc(new Date(q.next_attempt).toLocaleTimeString())})` : ''}`);
    }
    rows.sort((a, b) => b.at - a.at);
    $('log-status').innerHTML = waiting.length ? `<p style="font-size:.88rem;margin:.6rem 0 0">${waiting.length} SET(s) waiting: ${waiting.join(', ')}</p>` : '';
    renderRows($('log'), rows.slice(0, 60), `<p class="muted">${streams.length ? 'Nothing logged yet.' : 'No streams yet.'}</p>`);
    refillChecks();
  }
  // Checks run when a row is opened: the same validation the Receiver applies, with this sandbox's aud.
  const refillChecks = fillChecks($('log'), { issuer: location.origin, audience: () => currentCreds().client_id });
  $('log-btn').onclick = loadLog;
  $('log-stream').onchange = loadLog;
  let logTimer: number | undefined;
  const pollLog = () => { clearInterval(logTimer); if ($('log-auto').checked) logTimer = setInterval(() => { if (!document.hidden && !$('playground-body').hidden) loadLog(); }, 5000) as unknown as number; };
  $('log-auto').onchange = pollLog;

  // ── Firing events ──────────────────────────────────────────────────────
  function fillEvent() {
    const ev = EVENTS.find((e) => e.uri === $<HTMLSelectElement>('fire-type').value)!;
    $<HTMLTextAreaElement>('fire-sub').value = JSON.stringify(ev.sub_id, null, 2);
    const body = { ...ev.body };
    if (ev.uri.includes('/caep/')) body.reason_admin ??= { en: 'Signal sent from the shared-signals.dev playground' };
    $<HTMLTextAreaElement>('fire-body').value = JSON.stringify(body, null, 2);
  }
  $('fire-type').onchange = fillEvent;

  $('fire-btn').onclick = async () => {
    const out = $('fire-out');
    let sub_id, event;
    try { sub_id = JSON.parse($<HTMLTextAreaElement>('fire-sub').value); } catch { out.innerHTML = '<p class="error">sub_id is not valid JSON.</p>'; return; }
    try { event = JSON.parse($<HTMLTextAreaElement>('fire-body').value || '{}'); } catch { out.innerHTML = '<p class="error">Event claims are not valid JSON.</p>'; return; }
    const t = await token(); if (!t) return;
    const stream_id = $<HTMLSelectElement>('fire-stream').value || undefined;
    const r = await api('POST', '/api/events', { token: t, body: { stream_id, event_type: $<HTMLSelectElement>('fire-type').value, sub_id, event } });
    if (r.status !== 200) { out.innerHTML = `<p class="error">${r.status}: ${esc(errorText(r))}</p>`; return; }
    // A one-line result per stream; the SETs themselves are in the event log below.
    out.innerHTML = `${r.json.notes.map((n: string) => `<p class="muted" style="font-size:.88rem">${esc(n)}</p>`).join('')}
      <ul class="checks">${r.json.results.map((x: any) => `<li>${badge(x.outcome === 'delivered' || x.outcome === 'queued' ? 'pass' : x.outcome === 'held' || x.outcome === 'skipped' || x.outcome === 'retrying' ? 'warn' : 'fail', x.outcome)}
        <span><strong>${nameOf(x.stream_id)}</strong> — ${esc(x.detail)}</span></li>`).join('')}</ul>
      <p class="muted" style="font-size:.85rem">See the <a href="#log-panel">event log</a> for the SETs.</p>`;
    loadLog();
  };

  // ── curl walkthrough ───────────────────────────────────────────────────
  function renderCurl() {
    const c = currentCreds();
    $('curl-text').textContent = `# 1. Discover the Transmitter
curl ${ORIGIN}/.well-known/ssf-configuration

# 2. Get an access token (client credentials grant)
TOKEN=$(curl -s ${ORIGIN}/ssf/oauth/token \\
  -u '${c.client_id}:${c.client_secret}' \\
  -d grant_type=client_credentials -d 'scope=ssf.read ssf.manage' | jq -r .access_token)

# 3. Create a push stream to your Receiver
curl -s ${ORIGIN}/ssf/stream -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' -d '{
  "delivery": {
    "method": "urn:ietf:rfc:8935",
    "endpoint_url": "https://receiver.example.com/events",
    "authorization_header": "Bearer your-receiver-secret"
  },
  "events_requested": ["https://schemas.openid.net/secevent/caep/event-type/session-revoked"],
  "description": "My Receiver"
}'

# 4. Ask for a Verification event
curl -i ${ORIGIN}/ssf/verify -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \\
  -d '{"stream_id": "<stream_id>", "state": "hello"}'

# Poll streams: omit "delivery" (or use "urn:ietf:rfc:8936"), then
curl -s ${ORIGIN}/ssf/poll/<stream_id> -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \\
  -d '{"maxEvents": 10, "returnImmediately": true, "ack": []}'`;
  }

  $('client_id').oninput = $('client_secret').oninput = renderCurl;
  $('list-btn').onclick = listStreams;
  copyButtons();
  readHash();
  initCreds(() => { listStreams(); renderAccount(); });
  initAccount();
  fillEvent();
  listStreams();
  pollLog();
</script>
