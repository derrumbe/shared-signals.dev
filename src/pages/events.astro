---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { EVENTS } from '../data/events';
import { PROSPECTIVE_EVENTS, PROSPECTIVE_PROFILES } from '../data/prospective';
import { SPEC_URLS } from '../consts';
const INTEROP = new Set(['session-revoked', 'credential-change', 'device-compliance-change', 'risk-level-change']);

const groups = [
  { id: 'caep', title: 'CAEP events', spec: SPEC_URLS.caep, blurb: 'Session and access-condition changes while a user is signed in.' },
  { id: 'risc', title: 'RISC events', spec: SPEC_URLS.risc, blurb: 'Account-level changes: compromise, lifecycle, recovery.' },
  { id: 'ssf', title: 'SSF stream events', spec: SPEC_URLS.ssf, blurb: 'Housekeeping events about the stream itself, defined by the framework.' },
  { id: 'scim', title: 'SCIM events', spec: SPEC_URLS.scimEvents, blurb: 'Provisioning changes from a SCIM service provider, defined by IETF RFC 9967. The subject is a sub_id with format "scim" and the resource’s uri; a SET may carry several events from the same transaction, tied together by txn. Provisioning events come in a :full variant carrying the data and a :notice variant listing only the changed attributes.' },
] as const;

// Prospective profiles, each split into the draft's own categories, in draft order.
const prospective = PROSPECTIVE_PROFILES.map((p) => {
  const events = PROSPECTIVE_EVENTS.filter((e) => e.spec === p.id);
  const categories = [...new Set(events.map((e) => e.category))].map((c) => ({ title: c, events: events.filter((e) => e.category === c) }));
  return { ...p, count: events.length, categories };
});
---
<Base title="Event types" description="Every CAEP, RISC, SSF and SCIM event type: URI, claims, and an example Security Event Token payload — plus prospective event types from the WISE, IITP and MLE draft profiles, clearly marked.">
  <p class="eyebrow">Reference</p>
  <h1>Event types</h1>
  <p class="lede">Every event type defined by the OpenID Shared Signals specifications, plus the SCIM provisioning events of
  IETF RFC 9967, with their claims and an example SET payload. Summaries are ours; the linked specs are normative.
  Below them, <a href="#prospective">prospective events</a> from profiles still being drafted: WISE for workloads, IITP for
  infrastructure threats, and MLE for AI agents’ mandates.</p>

  <nav class="tags" style="margin-bottom:1rem">
    {groups.map((g) => <a href={`#${g.id}`} class={`tag ${g.id}`} style="text-decoration:none">{g.title}</a>)}
    {prospective.map((p) => <a href={`#${p.id}`} class={`tag ${p.id} draft`} style="text-decoration:none">{p.name} · prospective</a>)}
  </nav>

  {groups.map((g) => (
    <section id={g.id}>
      <h2>{g.title}</h2>
      <p class="muted">{g.blurb} <a href={g.spec}>Specification →</a></p>
      {EVENTS.filter((e) => e.spec === g.id).map((e) => <EventCard event={e} interop={e.spec === 'caep' && INTEROP.has(e.slug)} />)}
    </section>
  ))}

  <section id="prospective">
    <h2>Prospective events</h2>
    <div class="callout draft">
      <p><strong>Under development.</strong> These event types come from profiles of the Shared Signals Framework that are still
      being drafted. They are not final OpenID specifications: names, URIs, claims and values can change, or be dropped, from one
      draft to the next. They are listed so implementers can follow the work and give feedback.</p>
      <p>The sample <a href="/playground/">Transmitter and Receiver</a> do not send, accept or validate them, and they are not in
      the Transmitter’s <code>events_supported</code>.</p>
    </div>

    {prospective.map((p) => (
      <section id={p.id}>
        <h3 class="prospective-title"><span class={`tag ${p.id} draft`}>{p.name} · {p.draft}</span> {p.title}</h3>
        <p class="muted">{p.blurb} <a href={p.source}>Draft →</a></p>
        {p.notes && <ul class="muted notes">{p.notes.map((n) => <li>{n}</li>)}</ul>}
        <p class="muted" style="font-size:.85rem">{p.count} event types, transcribed from the draft at commit <code>{p.sync.commit}</code> (checked {p.sync.checked}).</p>
        {p.categories.map((c) => (
          <>
            {p.categories.length > 1 && <h4>{c.title}</h4>}
            {c.events.map((e) => <EventCard event={e} draft={p.draft} />)}
          </>
        ))}
      </section>
    ))}
  </section>
</Base>

<style>
  :global(.event summary){cursor:pointer;display:grid;grid-template-columns:auto 1fr;gap:.25rem .7rem;align-items:baseline;list-style:none}
  :global(.event summary::-webkit-details-marker){display:none}
  :global(.event summary strong){font-weight:600}
  :global(.event summary .ev-sum){grid-column:2;font-size:.92rem}
  :global(.event summary .tag.neutral),:global(.event summary .tag.ssf),:global(.event summary .tag.draft){grid-column:2;justify-self:start}
  :global(.event[open]){border-color:var(--accent)}
  :global(.event.prospective){border-style:dashed}
  :global(.ev-body){margin-top:.8rem;min-width:0}
  :global(.ev-body code){overflow-wrap:anywhere}
  .prospective-title{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem}
  h4{margin:1.4rem 0 .4rem;font-size:.95rem;color:var(--ink-soft)}
  .notes{font-size:.9rem;padding-left:1.2rem;margin:.2rem 0 .8rem}
  #prospective section + section{margin-top:2.5rem}
</style>
<script>
  // Open the event named in the URL hash, so /events/#caep-session-revoked deep-links.
  const open = () => { const el = location.hash && document.getElementById(location.hash.slice(1)); if (el instanceof HTMLDetailsElement) el.open = true; };
  open(); addEventListener('hashchange', open);
</script>
